
---
import {
    Instagram,
    MapPin,
    Phone,
    MessageCircle,
    BookOpen,
    ShoppingBag,
    UtensilsCrossed
} from 'lucide-astro';
import { site, whatsappUrl } from '../data/site';
---

<footer class="bg-[#252525] py-12 text-white">
    <div class="container">

        <div class="grid gap-9 md:grid-cols-3">


            <!-- Identidad del negocio -->
            <div>
                <a
                        href="/#inicio"
                        class="inline-flex items-center gap-4"
                        aria-label="Volver al inicio de El Jaibo"
                >
                    <div class="flex h-22.5 w-22.5 shrink-0 items-center justify-center rounded-2xl bg-[#FFF8ED] p-2">
                        <img
                            src="/images/logo.png"
                            alt="Logo oficial de Desconchadero El Jaibo"
                            width="90"
                            height="90"
                            loading="lazy"
                            class="h-full w-full object-contain"
                        />
                    </div>

                    <div>
                        <h2 class="text-lg font-black leading-tight text-white">
                            Desconchadero El Jaibo
                        </h2>

                        <p class="mt-2 text-xs font-bold tracking-wide text-[#F6C445]">
                            MARISCOS FRESCOS EN GUADALAJARA
                        </p>
                    </div>
                </a>

                <p class="mt-5 max-w-sm text-sm leading-relaxed text-[#ddd1c6]">
                    Mariscos frescos, preparados a tu gusto.
                    Visítanos en el Mercado del Mar de la 34,
                    en Guadalajara, Jalisco.
                </p>
            </div>

            <!-- Navegación -->
            <div>
                <h3 class="font-extrabold text-[#F6C445]">
                    Explora
                </h3>

                <nav
                        aria-label="Navegación del pie de página"
                        class="mt-4 flex flex-col gap-4 text-sm"
                >
                    <a
                        href="/#especialidades"
                        class="flex items-center gap-3 transition-colors hover:text-[#F6C445]"
                    >
                        <UtensilsCrossed size={19} strokeWidth={1.8} class="shrink-0 text-[#F6C445]" />
                        <span>Especialidades</span>
                    </a>

                    <a
                        href="/#menu"
                        class="flex items-center gap-3 transition-colors hover:text-[#F6C445]"
                    >
                        <BookOpen size={19} strokeWidth={1.8} class="shrink-0 text-[#F6C445]" />
                        <span>Nuestro menú</span>
                    </a>

                    <a
                        href="/#pedidos"
                        class="flex items-center gap-3 transition-colors hover:text-[#F6C445]"
                    >
                        <ShoppingBag size={19} strokeWidth={1.8} class="shrink-0 text-[#F6C445]" />
                        <span>Pedidos</span>
                    </a>

                    <a
                        href="/#ubicacion"
                        class="flex items-center gap-3 transition-colors hover:text-[#F6C445]"
                    >
                        <MapPin size={19} strokeWidth={1.8} class="shrink-0 text-[#F6C445]" />
                        <span>Ubicación</span>
                    </a>
                </nav>
            </div>


            <!-- Contacto -->

            <!-- Contacto -->
            <div>
                <h3 class="font-extrabold text-[#F6C445]">
                    Contacto
                </h3>

                <div class="mt-4 flex flex-col gap-4 text-sm">

                    <a
                        href={whatsappUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center gap-3 transition-colors hover:text-[#F6C445]"
                    >
                        <MessageCircle size={20} strokeWidth={2} class="shrink-0 text-[#25D366]" />
                        <span>WhatsApp: {site.phoneDisplay}</span>
                    </a>

                    <a
                        href={site.instagram}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center gap-3 transition-colors hover:text-[#F6C445]"
                    >
                        <Instagram size={20} strokeWidth={2} class="shrink-0 text-[#E879B5]" />
                        <span>Instagram</span>
                    </a>

                    <a
                        href={site.maps}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center gap-3 transition-colors hover:text-[#F6C445]"
                    >
                        <MapPin size={20} strokeWidth={2} class="shrink-0 text-[#F47B20]" />
                        <span>Google Maps</span>
                    </a>

                    <a
                        href={`tel:+${site.phoneE164}`}
                        class="flex items-center gap-3 transition-colors hover:text-[#F6C445]"
                    >
                        <Phone size={20} strokeWidth={2} class="shrink-0 text-[#F6C445]" />
                        <span>Llamar</span>
                    </a>

                </div>
            </div>


        </div>

        <div class="mt-10 border-t border-white/15 pt-6 text-center text-xs text-[#cbbfb4]">
            <p>© {new Date().getFullYear()} Desconchadero El Jaibo. Todos los derechos reservados.</p>
            <p class="mt-2">{site.opening}</p>
            <a
                    href="/aviso-de-privacidad/"
                    class="mt-3 inline-block text-xs text-gray-300 transition-colors hover:text-[#F6C445] hover:underline"
            >
                Aviso de privacidad
            </a>

            <button
                    id="open-cookie-settings"
                    type="button"
                    class="cursor-pointer text-xs text-gray-300 transition-colors hover:text-[#F6C445] hover:underline"
            >
                Configurar cookies
            </button>
        </div>

    </div>
</footer>

<!-- WhatsApp flotante en dispositivos móviles -->
<a
        class="fixed bottom-5 right-5 z-30 rounded-full bg-[#078f49] px-4 py-3 font-bold text-white shadow-xl transition-transform hover:scale-105 sm:hidden"
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Hacer pedido por WhatsApp"
>
    ✆ WhatsApp
</a>

<script>
    document.addEventListener('click', (event) => {
        const target = event.target;

        if (!(target instanceof Element)) return;

        const button = target.closest('#open-cookie-settings');

        if (!button) return;

        window.dispatchEvent(
            new Event('eljaibo:open-cookie-settings')
        );
    });
</script>