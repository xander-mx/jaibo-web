
---
import { highlights } from '../data/menu';
---

<section id="especialidades" class="section bg-[#fff8ed]">
    <div class="container">

        <div class="mb-9 text-center">
            <p class="eyebrow">Nuestras especialidades</p>

            <h2 class="section-title mt-2">
                Los favoritos de El Jaibo
            </h2>

            <p class="muted mt-3">
                Mariscos en concha y preparados para todos los antojos.
            </p>
        </div>

        <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-6">

            {highlights.map((item) => (
                    <article class="group overflow-hidden rounded-2xl bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">

                        <div class="flex aspect-4/3 items-center justify-center overflow-hidden bg-linear-to-br from-[#ffe5c2] to-[#f4b775]">

                            {item.photo ? (
                                    <img
                                            src={item.photo}
                                            alt={item.name}
                                            loading="lazy"
                                            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                                    />
                            ) : (
                                    <span class="text-6xl" aria-hidden="true">
                                        {item.icon}
                                      </span>
                            )}

                        </div>

                        <div class="p-3 text-center">
                            <h3 class="font-bold leading-tight">
                                {item.name}
                            </h3>

                            <p class="mt-2 text-sm font-bold text-[#c65d12]">
                                {item.price}
                            </p>
                        </div>

                    </article>
            ))}

        </div>

    </div>
</section>
