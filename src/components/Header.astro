
---
import { whatsappUrl } from '../data/site';
---

<header class="sticky top-0 z-40 bg-[#FFF8ED] shadow-sm">
    <div class="container flex min-h-16 items-center justify-between gap-2 py-2 lg:min-h-22.5 lg:gap-4">

        <a href="/#inicio" aria-label="Ir al inicio" class="flex items-center gap-3">
            <img
                    src="/images/logo.png"
                    width="100"
                    height="100"
                    alt="Logo oficial de Desconchadero El Jaibo"
                    class="h-12 w-auto object-contain sm:h-14 lg:h-19.5"
            />
            <span class="hidden text-lg font-black leading-tight text-[#252525] sm:block">
                EL JAIBO
                <small class="block text-xs font-extrabold tracking-wide text-[#81308a]">
                  DESCONCHADERO
                </small>
            </span>
        </a>

        <nav aria-label="Navegación principal" class="hidden items-center gap-7 font-semibold lg:flex">
            <a href="/#especialidades">Especialidades</a>
            <a href="/#menu">Menú</a>
            <a href="/#pedidos">Pedidos</a>
            <a href="/#ubicacion">Ubicación</a>
        </nav>

        <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Pedir por WhatsApp"
                class="btn btn-orange inline-flex shrink-0 items-center justify-center gap-2 whitespace-nowrap px-3 py-2 text-sm lg:px-5 lg:py-3"
        >
            <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="h-5 w-5 shrink-0"
                    aria-hidden="true"
            >
                <path d="M20.52 3.48A11.87 11.87 0 0 0 12.05 0C5.48 0 .13 5.35.12 11.93c0 2.1.55 4.15 1.6 5.96L0 24l6.29-1.65a11.9 11.9 0 0 0 5.75 1.47h.01c6.57 0 11.92-5.35 11.95-11.93a11.85 11.85 0 0 0-3.48-8.41ZM12.05 21.8a9.86 9.86 0 0 1-5.03-1.38l-.36-.21-3.73.98.99-3.64-.24-.38a9.88 9.88 0 0 1-1.52-5.24c0-5.45 4.44-9.89 9.9-9.89a9.83 9.83 0 0 1 7 2.9 9.83 9.83 0 0 1 2.89 7c-.02 5.46-4.46 9.9-9.9 9.9Zm5.43-7.42c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.76-1.64-2.06-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.87 1.22 3.07c.15.2 2.1 3.21 5.09 4.5.71.31 1.27.49 1.7.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35Z"/>
            </svg>

            <span class="lg:hidden">WhatsApp</span>
            <span class="hidden lg:inline">Pedir por WhatsApp</span>
        </a>

        <details class="relative lg:hidden">
            <summary
                    class="cursor-pointer list-none rounded-lg border border-[#e6e0d8] px-3 py-2 text-sm font-bold whitespace-nowrap"
            >
                ☰ Menú
            </summary>

            <nav class="absolute right-0 top-12 flex w-52 flex-col gap-4 rounded-xl border border-[#e6e0d8] bg-[#FFF8ED] p-4 shadow-lg">
                <a href="/#especialidades">Especialidades</a>
                <a href="/#menu">Menú</a>
                <a href="/#pedidos">Pedidos</a>
                <a href="/#ubicacion">Ubicación</a>
                <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">
                    Pedir por WhatsApp
                </a>
            </nav>
        </details>

    </div>
</header>
