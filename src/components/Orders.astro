
---
import { site, whatsappUrl } from '../data/site';
---

<section id="pedidos" class="section bg-[#fff0dc]">
    <div class="container">

        <div class="mx-auto max-w-205 text-center">
            <p class="eyebrow">Para llevar y a domicilio</p>

            <h2 class="section-title mt-2">
                ¿Se te antojaron unos mariscos?
            </h2>

            <p class="muted mt-4">
                Haz tu pedido por WhatsApp. Puedes recogerlo en nuestro puesto
                o consultar si llegamos hasta tu domicilio.
            </p>
        </div>

        <div class="mx-auto mt-9 grid max-w-205 gap-5 sm:grid-cols-2">

            <article class="rounded-2xl border border-[#f0dfcc] bg-white p-6 shadow-sm transition-shadow duration-300 hover:shadow-md">
                <div class="text-4xl" aria-hidden="true">🛍️</div>

                <h3 class="mt-3 text-xl font-extrabold">
                    Para llevar
                </h3>

                <p class="muted mt-2">
                    Elige tus mariscos favoritos, consulta disponibilidad
                    y pasa a recoger tu pedido en nuestro puesto.
                </p>
            </article>

            <article class="rounded-2xl border border-[#f0dfcc] bg-white p-6 shadow-sm transition-shadow duration-300 hover:shadow-md">
                <div class="text-4xl" aria-hidden="true">🛵</div>

                <h3 class="mt-3 text-xl font-extrabold">
                    A domicilio
                </h3>

                <p class="muted mt-2">
                    Contamos con servicio de reparto en zonas cercanas.
                    Confirma por WhatsApp la cobertura, disponibilidad
                    y costo de envío.
                </p>
            </article>

        </div>

        <div class="mt-8 text-center">
            <a
                    class="btn btn-green"
                    href={whatsappUrl}
                    target="_blank"
                    rel="noopener noreferrer"
            >
                Pedir por WhatsApp
            </a>

            <p class="muted mt-4 text-sm">
                {site.opening} · Tel. {site.phoneDisplay}
            </p>
        </div>

    </div>
</section>
